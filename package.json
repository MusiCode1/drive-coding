{
  "name": "drive-coding",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "start": "node scripts/dc-launch.mjs",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "lint:i18n": "./scripts/lint-no-hebrew-in-code.sh",
    "lint:rtl": "node scripts/lint-no-physical-classes.mjs",
    "format": "biome format --write .",
    "hooks:install": "git config core.hooksPath .githooks",
    "fe:build": "node scripts/dc-build-fe.mjs",
    "fe:build:if-missing": "node scripts/dc-build-fe.mjs --if-missing",
    "fe:build:if-stale": "node scripts/dc-build-fe.mjs --if-stale"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
