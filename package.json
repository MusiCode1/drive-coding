{
  "name": "drive-coding",
  "version": "0.32.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.5.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "node scripts/pm.mjs run-all-parallel dev",
    "start": "node scripts/dc-launch.mjs",
    "build": "node scripts/pm.mjs run-all build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "lint:i18n": "./scripts/lint-no-hebrew-in-code.sh",
    "lint:rtl": "node scripts/lint-no-physical-classes.mjs",
    "format": "biome format --write .",
    "hooks:install": "git config core.hooksPath .githooks",
    "worktrees:prune": "node scripts/prune-worktrees.mjs",
    "fe:build": "node scripts/dc-build-fe.mjs",
    "fe:build:if-missing": "node scripts/dc-build-fe.mjs --if-missing",
    "fe:build:if-stale": "node scripts/dc-build-fe.mjs --if-stale"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "jsdom": "^29.1.1",
    "package-manager-detector": "^1.8.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@agentclientprotocol/sdk": "1.2.1",
      "@anthropic-ai/claude-agent-sdk": "0.3.207",
      "@openai/codex": "0.144.1"
    }
  },
  "overrides": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.207",
    "@openai/codex": "0.144.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
