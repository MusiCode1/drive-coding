{
  "name": "@drive-coding/core",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./voice/*": "./src/voice/*.ts",
    "./ui/*": "./src/ui/*.ts",
    "./cache/*": "./src/cache/*.ts",
    "./i18n": "./src/i18n/index.ts",
    "./log": {
      "browser": "./src/log/browser.ts",
      "default": "./src/log/index.ts"
    },
    "./cwd-hash": "./src/cwd-hash.ts",
    "./cwd-validate": "./src/cwd-validate.ts",
    "./cli-resolve": "./src/cli-resolve.ts",
    "./cli-availability": "./src/cli-availability.ts",
    "./async/*": "./src/async/*.ts",
    "./acp/*": "./src/acp/*.ts",
    "./session": "./src/session/index.ts",
    "./config/*": "./src/config/*.ts",
    "./tts/*": "./src/tts/*.ts",
    "./usage/*": "./src/usage/*.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drive-coding/provider": "workspace:*",
    "@agentclientprotocol/sdk": "^1.2.1",
    "arktype": "^2.0.0",
    "marked": "^18.0.3",
    "neverthrow": "^8.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
