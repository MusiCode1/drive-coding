{
  "name": "@drive-coding/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./voice/*": "./src/voice/*.ts",
    "./ui/*": "./src/ui/*.ts",
    "./cache/*": "./src/cache/*.ts",
    "./i18n": "./src/i18n/index.ts",
    "./log": {
      "browser": "./src/log/browser.ts",
      "default": "./src/log/index.ts"
    },
    "./cwd-hash": "./src/cwd-hash.ts",
    "./cwd-validate": "./src/cwd-validate.ts",
    "./async/*": "./src/async/*.ts",
    "./config/*": "./src/config/*.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "provider-contract": "git+https://github.com/MusiCode1/provider-abstraction.git#main",
    "@agentclientprotocol/sdk": "^0.21.1",
    "arktype": "^2.0.0",
    "marked": "^18.0.3",
    "neverthrow": "^8.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
