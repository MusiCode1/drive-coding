#!/usr/bin/env bash
# tzlev-agents — ACP into sibling container `tzlev-agents` via SSH to host localhost.
#
# Why SSH (not podman --url unix://… exec): remote podman API exec does not
# correctly relay ACP stdio when used as the drive-coding child (BE never sees
# frames; wire stays empty). SSH → host → `podman exec -i` preserves pipes.
#
# Runs inside drive-coding (container A). Requires /usr/bin/ssh + key mount.
set -euo pipefail

CONTAINER="${TZLEV_AGENTS_CONTAINER:-tzlev-agents}"
WORKDIR="${TZLEV_AGENTS_WORKDIR:-/home/user/projects}"
KEY="${TZLEV_SSH_KEY:-/data/.ssh/tzlev-agents}"
HOST="${TZLEV_SSH_HOST:-user@127.0.0.1}"
SSH_BIN="${TZLEV_SSH_BIN:-/usr/bin/ssh}"
KNOWN_HOSTS="${TZLEV_SSH_KNOWN_HOSTS:-/data/.ssh/known_hosts}"

exec "$SSH_BIN" -T -i "$KEY" \
  -o BatchMode=yes \
  -o StrictHostKeyChecking=accept-new \
  -o UserKnownHostsFile="$KNOWN_HOSTS" \
  -o ConnectTimeout=10 \
  "$HOST" \
  "podman exec -i -w \"$WORKDIR\" -e HOME=/home/user -e PATH=/home/user/.local/bin:/home/user/.bun/bin:/home/user/.opencode/bin:/usr/local/bin:/usr/bin:/bin \"$CONTAINER\" /home/user/.local/bin/agent acp"
