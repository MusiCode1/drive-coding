#!/usr/bin/env bash
# tzlev-agents — ACP into sibling container `tzlev-agents` via SSH.
#
# B runs sshd on 127.0.0.1:2222 (network=host). A shares that stack, so
# this is A→B over loopback — not a hop through host podman exec.
#
# Requires /usr/bin/ssh + key mount in A (see drive-coding-tzlev.container).
set -euo pipefail

WORKDIR="${TZLEV_AGENTS_WORKDIR:-/home/user/projects}"
KEY="${TZLEV_SSH_KEY:-/data/.ssh/tzlev-agents}"
HOST="${TZLEV_SSH_HOST:-user@127.0.0.1}"
PORT="${TZLEV_SSH_PORT:-2222}"
SSH_BIN="${TZLEV_SSH_BIN:-/usr/bin/ssh}"
KNOWN_HOSTS="${TZLEV_SSH_KNOWN_HOSTS:-/data/.ssh/known_hosts}"

exec "$SSH_BIN" -T -i "$KEY" -p "$PORT" \
  -o BatchMode=yes \
  -o StrictHostKeyChecking=accept-new \
  -o UserKnownHostsFile="$KNOWN_HOSTS" \
  -o ConnectTimeout=10 \
  "$HOST" \
  "cd \"$WORKDIR\" && exec /home/user/.local/bin/agent acp"
