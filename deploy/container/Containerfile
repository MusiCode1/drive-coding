# Containerfile — drive-coding: backend + built FE in one image.
#
# Mirrors deploy/systemd/drive-coding-*.service, with the ExecStartPre work
# (bun install + FE build) moved to image build time.
#
# Build context = repo root:
#   podman build -f deploy/container/Containerfile -t drive-coding:edge .
#
# Notes anchored in the code:
#   - Entry is bin/drive-coding.ts, NOT server.ts — only it supports --env-file.
#   - FE_ENV / FE_PREVIEW_LABEL are read at BUILD time by vite.config.ts,
#     so they are ARG in the builder, not ENV at runtime.
#   - Config paths come from os.homedir() (provider/src/config/cli-config-file.ts:30),
#     NOT from XDG_CONFIG_HOME. Hence HOME=/data + a volume at /data/.config.
#   - oven/bun has no node/git/curl. dc-build-fe.mjs only imports node: builtins,
#     so bun runs it. Without git it stamps the FE version "nogit" — cosmetic.

ARG BUN_TAG=1.3

# ───────────────────────── builder ─────────────────────────
FROM docker.io/oven/bun:${BUN_TAG} AS builder
WORKDIR /app

ARG FE_ENV=preview
ARG FE_PREVIEW_LABEL=edge
ENV FE_ENV=${FE_ENV} \
    FE_PREVIEW_LABEL=${FE_PREVIEW_LABEL}

COPY . .

RUN bun install --frozen-lockfile

# @drive-coding/acp-wire exports ./dist/*, and dist/ is gitignored — so a clean
# checkout has no dist and the FE build dies with:
#   Rollup failed to resolve import "@drive-coding/acp-wire/browser"
# The systemd ExecStartPre never builds it; on the dev box dist/ merely survives
# from an earlier manual build. Explicit here.
#
# TEMPORARY. slice/acp-wire-platform-entries (2c562f7c) points exports at src/,
# which removes dist/ from the picture entirely. Delete this RUN once that
# lands on edge, and rebuild.
RUN cd packages/acp-wire && bun run build

# No --if-stale: there is no prior build in a fresh image.
RUN bun scripts/dc-build-fe.mjs

# ───────────────────────── runtime ─────────────────────────
FROM docker.io/oven/bun:${BUN_TAG} AS runtime
WORKDIR /app

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="drive-coding" \
      org.opencontainers.image.revision="${GIT_SHA}"

# HOME drives every os.homedir() lookup — cli-specs.jsonc and wire-recordings.
# 0.0.0.0 (not 127.0.0.1 as in the systemd unit): inside a netns, loopback is
# unreachable from outside. Safety comes from PublishPort=127.0.0.1 + nftables.
ENV NODE_ENV=production \
    HOME=/data \
    PORT=4000 \
    DRIVE_CODING_HOST=0.0.0.0 \
    FE_STATIC_DIR=/app/packages/frontend/build \
    DC_GIT_SHA=${GIT_SHA}

COPY --from=builder /app /app

RUN mkdir -p /data/.config/drive-coding
VOLUME ["/data/.config/drive-coding"]

EXPOSE 4000

# Ignored in OCI image format (podman warns) — the Quadlet HealthCmd is what
# actually runs. Kept so `docker build --format docker` also works.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD bun /app/deploy/container/healthcheck.js

CMD ["bun", "packages/backend/src/bin/drive-coding.ts"]
