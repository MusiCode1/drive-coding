[Unit]
Description=voice-acp backend (Hono + static FE, via OneCLI gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/projects/voice-acp/dev
Environment=PORT=4000
Environment=FE_STATIC_DIR=/home/user/projects/voice-acp/dev/packages/frontend/build
# CORS: CF Pages (legacy) + localhost + ה-CF tunnel הציבורי (drive-coding-dev).
Environment=CORS_ORIGINS=https://drive-coding.pages.dev,http://localhost:4000,https://drive-coding-dev.example.com
# opencode has its own Anthropic OAuth — strip OneCLI's proxy/placeholder vars
# that would otherwise break opencode's auth (see scripts/opencode-clean.sh).
Environment=OPENCODE_BIN=/home/user/projects/voice-acp/dev/scripts/opencode-clean.sh
# ExecStartPre בונה את ה-FE (+core) לפני שה-BE עולה — כך `systemctl restart`
# (וגם boot) תמיד מעלה את הקוד העדכני לאוויר. ה-build incremental: מהיר כשאין
# שינוי. אין צורך ב-unit/script נפרד ל-build.
ExecStartPre=/bin/bash -lc 'source /home/user/.config/shell/shared-env.sh && pnpm build'
# systemd gives a minimal PATH (/usr/bin:/bin) — opencode/npx/node/onecli are NOT
# on it, so the BE fails to spawn the CLI agent ("spawn returned no pid").
# Source the shared env script: it sets the full PATH, ONECLI_API_HOST, fnm and
# locale, and is explicitly designed to be sourced by systemd user services.
# `exec` replaces the shell so systemd tracks the real onecli/bun process.
ExecStart=/bin/bash -c 'source /home/user/.config/shell/shared-env.sh && exec onecli run --agent voice-acp -- bun packages/backend/src/server.ts'
# build יכול לקחת זמן — תן ל-startup מספיק זמן לפני timeout.
TimeoutStartSec=300
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target

# הסביבה הציבורית: https://drive-coding-dev.example.com (CF tunnel home-server,
# CT 104 → 192.168.x.x:4000). ה-tunnel מנוהל מרכזית ע"י cloudflared על CT 104 —
# אין systemd unit מקומי ל-tunnel (tuns.sh הוסר 2026-06-01).
