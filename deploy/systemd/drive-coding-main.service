[Unit]
Description=drive-coding MAIN (prod) — Hono + static FE on :4000
After=network-online.target
Wants=network-online.target
# Default (5 tries / 10s) locks the unit in failed after a short crash-loop
# and it never comes back alone. A wider window lets it recover.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Projects/drive-coding/main

# --- Deployment identity. Wins over .env and config.jsonc (env > config file) ---
Environment=PORT=4000
Environment=DRIVE_CODING_HOST=127.0.0.1
Environment=FE_STATIC_DIR=%h/Projects/drive-coding/main/packages/frontend/build

# No FE_ENV → vite.config.ts falls through to prod: title = "Drive Coding"
# (no badge), source maps off (clean public bundle).
# No WIRE_RECORD — prod stays quiet. Temporary debug: drop-in with
# Environment=WIRE_RECORD=1 (see drive-coding-dev.service).

# CORS: CF Pages (legacy) + localhost + public tunnel hostname for main.
Environment=CORS_ORIGINS=https://drive-coding.pages.dev,http://localhost:4000,https://drive-coding.musicode.ovh
# Public origin: auto-added to effective CORS; MCP chat links. Not DRIVE_CODING_BASE (child CLIs stay loopback).
Environment=PUBLIC_BASE_URL=https://drive-coding.musicode.ovh

# opencode has its own Anthropic OAuth. The wrapper strips proxy/placeholder
# vars OneCLI used to inject; without OneCLI it is a harmless passthrough,
# kept so bringing OneCLI back does not require touching the unit.
Environment=OPENCODE_BIN=%h/Projects/drive-coding/main/scripts/opencode-clean.sh

# ⚠️ CLI_SPECS_FILE intentionally unset. Default is
# ~/.config/drive-coding/cli-specs.jsonc — the live provider catalog.
# Pointing at deploy/cli-specs.jsonc would hide them and leave only the
# obsolete OneCLI claude workaround.

# ExecStartPre syncs deps and builds FE if missing/stale (build-if-stale:
# compares build/_app/version.json to HEAD).
# Ongoing FE refresh: `bun run fe:build` without restart — live agents survive.
# restart is for BE changes only.
ExecStartPre=/bin/bash -lc 'source %h/.config/shell/shared-env.sh && bun install --frozen-lockfile && node scripts/dc-build-fe.mjs --if-stale'

# systemd gives a minimal PATH — source the shared env (bun · node/fnm · opencode).
# Entry is bin/drive-coding.ts (not server.ts): only it supports --env-file.
# --env-file is **non-overriding**: Environment= above wins; the file only
# supplies missing secrets (TTS provider keys). Missing file → warning, not failure.
# The env file sits above the worktrees (shared by main/dev/edge) and outside any repo.
ExecStart=/bin/bash -c 'source %h/.config/shell/shared-env.sh && exec bun packages/backend/src/bin/drive-coding.ts --env-file %h/Projects/drive-coding/.env'

TimeoutStartSec=300
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

# Public path: CF tunnel → http://localhost:4000.
# BE listens on loopback only; ingress is managed via CF API
# (PUT cfd_tunnel configurations), not a local config file.
