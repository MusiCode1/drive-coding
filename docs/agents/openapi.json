  "components": {
    "schemas": {
      "CreateAgentInputFull": {
        "type": "object",
        "properties": {
          "cliKind": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "closeOnTurnEnd": {
            "type": "boolean"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "existingSessionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "includeLastAssistantText": {
            "type": "boolean"
          },
          "modelOverride": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "notifyOnDone": {
            "anyOf": [
              {
                "type": "string",
                "description": "a UUID",
                "format": "uuid",
                "pattern": "^[\\da-f]{8}-[\\da-f]{4}-[1-8][\\da-f]{3}-[89ab][\\da-f]{3}-[\\da-f]{12}$"
              },
              {
                "const": "00000000-0000-0000-0000-000000000000",
                "description": "a UUID",
                "format": "uuid"
              },
              {
                "const": "ffffffff-ffff-ffff-ffff-ffffffffffff",
                "description": "a UUID",
                "format": "uuid"
              }
            ],
            "description": "a UUID",
            "format": "uuid"
          },
          "parentAgentId": {
            "type": "string"
          },
          "permissionPolicy": {
            "enum": [
              "allow_always",
              "allow_once",
              "ask",
              "reject_once"
            ]
          },
          "roleLabel": {
            "type": "string"
          },
          "systemPrompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "cliKind",
          "cwd"
        ]
      },
      "PatchAgentInput": {
        "type": "object",
        "properties": {
          "acpSessionId": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "persistent": {
            "type": "boolean"
          },
          "replace": {
            "type": "boolean"
          },
          "status": {
            "const": "ready"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
