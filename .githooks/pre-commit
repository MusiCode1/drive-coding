#!/usr/bin/env bash
# pre-commit hook for drive-coding.
#
# Currently runs only the i18n lint (Hebrew-in-code detector).
# Add more checks here as the project grows.
#
# Installed via: pnpm run hooks:install
# (which runs: git config core.hooksPath .githooks)
#
# To skip ad hoc: git commit --no-verify

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1. Hebrew-in-code check
./scripts/lint-no-hebrew-in-code.sh
