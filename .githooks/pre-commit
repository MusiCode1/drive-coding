#!/usr/bin/env bash
# pre-commit hook for drive-coding.
#
# Runs the i18n lint (Hebrew-in-code detector) and the size/impurity ratchet.
# Both are skippable with `git commit --no-verify`.
# There is no CI; skipping the hook is enough to bypass them.
#
# Installed via: bun run hooks:install
# (which runs: git config core.hooksPath .githooks)
#
# To skip ad hoc: git commit --no-verify

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1. Hebrew-in-code check
./scripts/lint-no-hebrew-in-code.sh

# 2. Size/impurity ratchet.
#    exit 2 = must-shrink warning only — printed, NOT blocking at commit time.
#    The same condition blocks at pre-push and in dod-check, where the unit of
#    work is the whole branch/slice rather than a single commit.
set +e
node scripts/lint-file-size.mjs
rc=$?
set -e
if [ "$rc" -eq 2 ]; then
  echo ""
  echo "⚠️  אזהרה בלבד — הקומיט ממשיך."
  echo "   החסימה תגיע ב-pre-push וב-scripts/dod-check.sh check."
  rc=0
fi

# 3. Agent docs: front matter, tag vocabulary, index.json, English only.
#    Absolute — no ratchet and no exit 2.
if [ "$rc" -eq 0 ]; then
  set +e
  node scripts/lint-agent-docs.mjs
  rc=$?
  set -e
fi

exit "$rc"
