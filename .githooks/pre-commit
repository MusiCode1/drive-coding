#!/usr/bin/env bash
# pre-commit hook for drive-coding.
#
# Currently runs the i18n lint (Hebrew-in-code detector) and the
# size/impurity ratchet. Both are skippable with `git commit --no-verify`.
# There is no CI; skipping the hook is enough to bypass them.
#
# Installed via: bun run hooks:install
# (which runs: git config core.hooksPath .githooks)
#
# To skip ad hoc: git commit --no-verify

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1. Hebrew-in-code check
./scripts/lint-no-hebrew-in-code.sh

# 2. Size/impurity ratchet (skip: git commit --no-verify)
node scripts/lint-file-size.mjs
