data
tsconfig.tsbuildinfo
# tsc build output for backend/plugins (source is .ts, compiled output is gitignored)
packages/backend/plugins/*.js
packages/backend/plugins/*.js.map
packages/backend/plugins/*.d.ts
packages/backend/plugins/*.d.ts.map
packages/frontend/build__hidden_test/**

# Verification reports live in the SEPARATE private reports repo
# (~/projects/brief-driven-slices/main/reports/<project>/), NOT here.
# Agents write there; this guard keeps stray copies out of the project repo.
reports/
docs/reports/
docs/*-verification-report.md

# docs/ (briefs, decisions, walkthrough) עבר ל-docs-repo (private, משותף בין
# פרויקטים). docs-for-llm/ הוא Junction (Windows) / symlink (Linux) לעותק
# המקומי של docs-repo/drive-coding — לא תוכן אמיתי בריפו הזה.
docs/
docs-for-llm/

# FE build staging dirs (atomic swap — slice-fe-build-decouple)
packages/frontend/.build-staging/
packages/frontend/.build-old/

# Worktrees live under .worktrees/ (each is its own checkout — never track as gitlink)
.worktrees/
.tmp/

# Local-only logs / raw wire-captures / research artifacts (never in repo).
# Canonical censored fixtures live under the relevant package; this is raw material.
.research/
**/.localappdata/**
.localappdata/
