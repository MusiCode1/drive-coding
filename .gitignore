node_modules/
dist/
build/
.svelte-kit/
*.log
.env
.env.local
.DS_Store
packages/backend/data/
scripts/node_modules
.codenomad/
.mockups-tmp
.playwright-cli/
.specstory/
data
tsconfig.tsbuildinfo
# tsc build output for backend/plugins (source is .ts, compiled output is gitignored)
packages/backend/plugins/*.js
packages/backend/plugins/*.js.map
packages/backend/plugins/*.d.ts
packages/backend/plugins/*.d.ts.map
packages/frontend/build__hidden_test/**

# Verification reports live in the SEPARATE private reports repo
# (~/projects/brief-driven-slices/main/reports/<project>/), NOT here.
# Agents write there; this guard keeps stray copies out of the project repo.
reports/
docs/reports/
docs/*-verification-report.md

# docs/ (briefs, decisions, walkthrough) עבר ל-docs-repo (private, משותף בין
# פרויקטים). docs-for-llm/ הוא Junction (Windows) / symlink (Linux) לעותק
# המקומי של docs-repo/drive-coding — לא תוכן אמיתי בריפו הזה.
#
# ה-/ המוביל מעגן את התבנית לשורש הריפו בלבד. בלי העיגון, git מתעלם מכל
# תיקיית docs/ בכל עומק — למשל packages/<pkg>/docs/ — וקובץ חדש שם נחסם
# בשקט בלי אזהרה.
# /docs/* ולא /docs/ — git **אינו** מאפשר להחזיר קובץ שתיקיית-האב שלו מוחרגת.
# עם /docs/ הקובץ הציבורי היחיד למטה היה נחסם בשקט, בלי שום אזהרה.
/docs/*
# תיעוד ציבורי מיועד-לבני-אדם — נשאר בריפו הזה במפורש.
!/docs/configuration.md
# בלי / בסוף — docs-for-llm הוא סימלינק, וגit מתייחס לסימלינק כקובץ.
# תבנית שמסתיימת ב-/ מתאימה לספריות בלבד ולא הייתה חוסמת אותו.
/docs-for-llm

# FE build staging dirs (atomic swap — slice-fe-build-decouple)
packages/frontend/.build-staging/
packages/frontend/.build-old/

# Worktrees live under .worktrees/ (each is its own checkout — never track as gitlink)
.worktrees/
.tmp/

# Executor dispatch artifacts (progress.md / outcome.json) — local only, never push
.dispatch/

# Local-only logs / raw wire-captures / research artifacts (never in repo).
# Canonical censored fixtures live under the relevant package; this is raw material.
.research/
**/.localappdata/**
.localappdata/

# 🔴 כאן ישבו סימני-קונפליקט לא-פתורים (<<<<<<< / ======= / >>>>>>>) ששרדו
# מיזוג קודם. git מתייחס אליהם כאל תבניות רגילות, ולכן שום דבר לא התלונן —
# בזמן ש-`docs/` בלי עיגון חסם כל תיקיית docs בכל עומק. הכלל היחיד מוגדר למעלה.
!packages/frontend/docs/
@Vendor/
docs/plans/
